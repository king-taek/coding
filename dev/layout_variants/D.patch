+def test_no_horizontal_overflow_at_800(qapp):
+    """★ 800px 창에서 가로 스크롤이 없어야 한다.
+
+    장비 카드 2열이 호스트의 **최소폭**을 972px 로 밀어 올리는데, 흘려 넣을 폭을
+    그 호스트의 `width()` 에서 읽고 있었다 — 자기가 만든 폭을 자기가 다시 읽는
+    되먹임이라 창을 줄여도 1열로 접히지 않았다(카드 908px, 가로 스크롤 실측)."""
+    from PyQt6.QtWidgets import QScrollArea
+    page = sp.SetupPage()
+    try:
+        page.show()
+        for w in (1512, 1024, 800):        # 넓은 쪽에서 줄여 와야 재현된다
+            page.resize(w, 900)
+            for _ in range(12):
+                qapp.processEvents()
+        scroll = page.findChild(QScrollArea)
+        assert scroll is not None
+        assert not scroll.horizontalScrollBar().isVisible(), "가로 스크롤이 생겼다"
+        assert scroll.widget().minimumSizeHint().width() <= scroll.viewport().width()
+    finally:
+        page.deleteLater()
