+# ── 설정 카드의 '라벨 왼쪽 — 값 오른쪽' 축 ────────────────────────────────────
+def _right_x(page, w) -> int:
+    """페이지 좌표계에서 위젯의 오른쪽 변."""
+    return w.mapTo(page, w.rect().topRight()).x()
+
+
+def test_setting_values_share_one_right_axis(qapp):
+    """★ 실행 옵션·매칭 설정의 **값들이 한 축에서 끝난다**(macOS/iOS 설정 관습).
+
+    예전에는 값 **뒤**에 `addStretch(1)` 가 있어 남는 폭이 전부 오른쪽에 고였다 —
+    1512px 창에서 카드(1434)의 오른쪽 1135px(75%)이 빈 띠였고, 같은 카드 안에서
+    `SwitchRow` 만 토글을 오른쪽 끝에 붙여 **축이 둘로 갈라져** 있었다."""
+    page = sp.SetupPage()
+    try:
+        page.show()
+        page.resize(1512, 1000)
+        page.legacy_switch.set_on(True, emit=True)     # 구형 컨트롤까지 모두 보이게
+        for _ in range(12):
+            qapp.processEvents()
+        axis = {
+            "자동화 수준": _right_x(page, page.auto_group),
+            "진행 범위": _right_x(page, page.scope_group),
+            "허용 오차": _right_x(page, page.tol_plus_btn),
+            "구형 토글": _right_x(page, page.legacy_switch.switch),
+            "구형 하위선택": _right_x(page, page.legacy_group),
+            "임계치": _right_x(page, page.threshold_label),
+        }
+        assert len(set(axis.values())) == 1, f"축이 갈라졌다: {axis}"
+    finally:
+        page.deleteLater()
+
+
+def test_axis_is_capped_on_ultra_wide(qapp):
+    """축에는 **상한**이 있다 — 2560px 창에서 라벨과 값이 화면 양 끝으로 갈라지면
+    한 줄로 읽히지 않는다(눈이 가로로 멀리 이동하는 것도 실패다)."""
+    from aoi_verification.app.ui import theme
+    page = sp.SetupPage()
+    try:
+        page.show()
+        page.resize(1512, 1000)
+        for _ in range(12):
+            qapp.processEvents()
+        at_1512 = _right_x(page, page.auto_group)
+        page.resize(2560, 1000)
+        for _ in range(12):
+            qapp.processEvents()
+        at_2560 = _right_x(page, page.auto_group)
+        assert at_2560 == at_1512, "초광폭에서 값이 계속 오른쪽으로 달아났다"
+        # 상한은 토큰이 정한다 — 축 폭이 `axis_max_w` 를 넘지 않는다.
+        assert at_2560 <= theme.PROFILE.axis_max_w + 2 * theme.PROFILE.page_margin
+    finally:
+        page.deleteLater()
+
