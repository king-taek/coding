+        need = max(w.minimumSizeHint().width() for w in rows)
+        avail = self._avail_w(
+            host, 2 * (theme.PROFILE.page_margin + theme.PROFILE.card_pad))
+        reflow_into_grid(grid, rows, avail, max(1, need))
+
+    def _reflow_card_grids(self) -> None:
