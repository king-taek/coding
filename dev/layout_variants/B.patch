+def test_reflow_uses_horizontal_spacing_when_axes_differ(qapp):
+    """★ 열 계산은 **가로** 간격을 봐야 한다.
+
+    `QGridLayout.spacing()` 은 가로/세로 간격이 다르면 -1 을 돌려준다(설정 카드
+    그리드가 그렇다: 열 사이는 넓게, 행 사이는 카드 리듬대로).  그걸 그대로 쓰면
+    간격을 0 으로 보고 열을 하나 더 줘 가로로 넘친다."""
+    host = QWidget()
+    grid = QGridLayout(host)
+    grid.setHorizontalSpacing(100)
+    grid.setVerticalSpacing(4)
+    assert grid.spacing() == -1, "전제 붕괴: 축이 달라도 -1 이 아니다"
+    widgets = [QWidget(host) for _ in range(3)]
+    # 2열에 필요한 폭 = 200*2 + 100 = 500.  480 에는 못 들어간다(간격을 0 으로
+    # 보면 480//200 = 2열이 되어 넘친다).
+    assert reflow_into_grid(grid, widgets, 480, 200) == 1
+    assert reflow_into_grid(grid, widgets, 500, 200) == 2
+    host.deleteLater()
+
