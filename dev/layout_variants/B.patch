+def test_card_interior_uses_columns_when_wide_and_folds_when_narrow(qapp):
+    """설정이 카드 폭을 통째로 쓰고 내용은 377px 에서 끝나면 1512px 창의 오른쪽 75%가
+    빈 채로 남는다(실측).  카드 **안**을 열로 나눠 설정들이 가로축을 나눠 쓰게 하고,
+    좁아지면 열이 줄어 다시 세로로 접히게 한다."""
+    page = sp.SetupPage()
+    try:
+        page.show()
+        page.resize(1512, 1000)
+        for _ in range(10):
+            qapp.processEvents()
+        assert page._card_grids, "카드 내부 그리드가 사라졌다"
+        wide = [_grid_cols(g) for _, g, _ in page._card_grids]
+        assert max(wide) >= 2, f"넓은 창에서도 한 열뿐이다: {wide}"
+
+        page.resize(640, 1000)
+        for _ in range(10):
+            qapp.processEvents()
+        narrow = [_grid_cols(g) for _, g, _ in page._card_grids]
+        assert max(narrow) == 1, f"좁은 창에서 열이 줄지 않았다: {narrow}"
+        assert all(n <= w for n, w in zip(narrow, wide))
+    finally:
+        page.deleteLater()
+
+
+def test_no_horizontal_scroll_after_shrinking_from_wide(qapp):
+    """★ 열 수가 **잠기는** 회귀.
+
+    가용 폭을 '자기 폭'으로만 재면, 2열이 요구하는 최소폭이 곧 자기 폭이 되어 창을
+    줄여도 그 아래로 내려가지 못한다 — 1열로 돌아올 수 없다.  실측: 1512 → 800px 로
+    줄이면 장비 행이 2열에 잠겨 카드가 908px(창 800px)로 남고 가로 스크롤 186px 이
+    났다.  창이 정하는 뷰포트 폭을 상한으로 씌워야 잠김이 풀린다."""
+    from PyQt6.QtWidgets import QScrollArea
+    page = sp.SetupPage()
+    try:
+        page.show()
+        scroll = page.findChild(QScrollArea)
+        assert scroll is not None
+        for w in (1512, 1280, 1024, 800):
+            page.resize(w, 950)
+            for _ in range(10):
+                qapp.processEvents()
+        assert scroll.horizontalScrollBar().maximum() == 0, "가로 스크롤이 생겼다"
+        assert scroll.widget().width() <= scroll.viewport().width(), \
+            f"본문 {scroll.widget().width()}px > 뷰포트 {scroll.viewport().width()}px"
+    finally:
+        page.deleteLater()
+
