+def test_legacy_toggle_stays_put_at_every_column_count(qapp):
+    """★ 카드 안을 2열로 나눠도 토글은 제자리다.
+
+    조건부 위젯(구형 하위 선택·임계치)이 스위치와 **같은 그리드 행**에 앉으면, 그것이
+    나타날 때 행 높이가 커지면서 행 안에서 세로 중앙 정렬된 토글이 내려간다 — 위에서
+    고친 결함이 열 방향으로 옷만 갈아입고 재발하는 형태다.  그래서 조건부 위젯은
+    **언제나 스위치 아래 벌**에 둔다.  1열/2열 양쪽 폭에서 확인한다.
+
+    ※ 행 위젯이 아니라 **토글 자신**의 y 를 잰다 — 행이 제자리여도 행이 높아지면
+    가운데 정렬된 토글은 움직인다."""
+    page = sp.SetupPage()
+    try:
+        page.show()
+        for w in (1512, 1024, 800, 640):
+            page.resize(w, 1000)
+            for _ in range(10):
+                qapp.processEvents()
+
+            def _y() -> int:
+                return page.legacy_switch.switch.mapTo(page, QPoint(0, 0)).y()
+
+            before = _y()
+            page.legacy_switch.set_on(True, emit=True)
+            for _ in range(10):
+                qapp.processEvents()
+            assert _y() == before, f"{w}px: 켜자 토글이 {before} → {_y()} 로 움직였다"
+            page.legacy_switch.set_on(False, emit=True)
+            for _ in range(10):
+                qapp.processEvents()
+            assert _y() == before, f"{w}px: 끄자 토글이 {before} → {_y()} 로 움직였다"
+    finally:
+        page.deleteLater()
+
