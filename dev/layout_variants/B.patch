+    def _viewport_w(self) -> int:
+        """창이 본문에 **실제로 내주는** 폭.
+
+        스크롤 뷰포트의 폭은 창 크기가 정하므로 내용이 넓어져도 따라 커지지 않는다 —
+        그래서 잠김(latch) 을 푸는 기준으로 쓸 수 있는 유일한 값이다."""
+        scroll = getattr(self, "_scroll", None)
+        w = scroll.viewport().width() if scroll is not None else 0
+        if w > 1:
+            return w
+        w = self.width() or 0
+        if w > 1:
+            return w
+        p = self.parentWidget()
+        return p.width() if p is not None else 0
+
+    def _avail_w(self, host: Optional[QWidget], inset: int) -> int:
+        """``host`` 가 쓸 수 있는 폭 — 자기 폭에 **뷰포트 상한**을 씌운다.
+
+        ★ 자기 폭만 보면 열 수가 **잠긴다**.  2열이 요구하는 최소폭이 곧 호스트의 폭이
+          되어, 창을 줄여도 avail 이 그 아래로 내려가지 않아 1열로 돌아오지 못한다.
+          실측: 1512 → 800px 로 줄이면 장비 행이 2열에 잠겨 본문이 972px 로 남고
+          가로 스크롤 186px 이 났다(카드 908px > 창 800px).  뷰포트 폭에서 바깥
+          여백(``inset``)을 뺀 값을 상한으로 씌워 잠김을 끊는다.
+
+        ★ 그러면서도 **자기 폭을 상한으로 유지**한다 — 페이지 폭만 보면 좁은 그리드
+          칸 안에서도 1512px 인 줄 알고 두 카드를 나란히 둬 입력란이 104px 이 된다."""
+        own = host.width() if host is not None else 0
+        cap = self._viewport_w() - max(0, inset)
+        if cap <= 1:
+            return own
+        return min(own, cap) if own > 1 else cap
