+    from aoi_verification.app.ui.widgets.option_group import OptionGroup
+    g = OptionGroup([("a", "기본 모드 (정밀 비교)"), ("b", "고효율 모드 (CPU+GPU)")])
+    try:
+        narrow = g.one_row_min_w()
+        assert narrow > 0
+        g.show()
+        g.resize(narrow + 200, 60)          # 한 줄로 펴진다
+        for _ in range(8):
+            qapp.processEvents()
+        assert g.one_row_min_w() == narrow, "펴진 뒤 하한이 달라졌다"
