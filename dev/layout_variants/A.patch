+def test_option_cards_sit_side_by_side_when_wide(qapp):
+    """★ 두 카드 다 내용 폭이 380px 안팎인데 각자 전체폭 한 줄을 먹고 있었다.
+
+    1512px 창에서 카드는 1434px 인데 내용은 377px 에서 끝나 오른쪽 75% 가 빈 채로
+    화면만 길어졌다(실측).  넓으면 한 행에 나란히 세워 남는 폭을 쓴다."""
+    from aoi_verification.app.ui.widgets.option_group import _grid_cols
+    page = sp.SetupPage()
+    try:
+        page.show()
+        page.resize(1512, 950)
+        for _ in range(10):
+            qapp.processEvents()
+        run_card, engine_card = page._options_cards
+        assert _grid_cols(page._options_grid) == 2, "넓은 창인데 카드가 세로로 쌓였다"
+        # 같은 행 · 서로 다른 열 → 위아래가 아니라 좌우로 선다.
+        assert run_card.y() == engine_card.y()
+        assert run_card.x() < engine_card.x()
+        # 카드가 창 폭의 절반 아래로 줄어야 '두 장이 들어갔다'는 뜻이다.
+        assert run_card.width() < page.width() * 0.6
+    finally:
+        page.deleteLater()
+
