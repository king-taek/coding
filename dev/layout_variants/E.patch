+        aside_w = self._aside_width()
+        # 본론의 하한은 '폴더 카드 **한 장**' 이다 — 지금 몇 열인지와 무관해야 한다.
+        main_need = max((c.minimumSizeHint().width() for c in self._device_cards),
+                        default=self._PATH_MIN_W)
+        docked = content >= main_need + gap + aside_w
+        self._dock_aside(docked, aside_w)
+        self._main_w = content - gap - aside_w if docked else content
+        self._reflow_device_row()
+        # 레일 안 설정 칸 — 좁으면 한 줄에 하나, 아래로 내려앉아 넓어지면 여러 개.
+        col_w = (aside_w if docked else content) - 2 * pad
+        cell_min = aside_w - 2 * pad
+        for grid, cells in getattr(self, "_setting_grids", ()):
+            reflow_into_grid(grid, cells, col_w, cell_min)
