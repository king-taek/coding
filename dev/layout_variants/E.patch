+def test_no_horizontal_scroll_when_window_shrinks(qapp):
+    """★ 넓게 열었다가 **줄인** 경우도 넘치지 않아야 한다 — 처음부터 800 인 경우와 다르다.
+
+    실측 회귀: 폴더 행이 한 번 2열이 되면 그리드 최소폭이 908px 로 굳고,
+    `_reflow_device_row` 가 **자기 호스트의 `width()`** 를 읽어 열 수를 정했다.  그 폭은
+    자기 최소폭 아래로 내려가지 않으므로 창을 800 으로 줄여도 계속 908 을 보고 2열을
+    유지했다 — 800px 창에 908px 카드(가로 스크롤 108px).  가용 폭을 창에서 **계산**해
+    되먹임을 끊었다(`SetupPage._content_width`)."""
+    from PyQt6.QtWidgets import QScrollArea
+    page = sp.SetupPage()
+    try:
+        page.show()
+        scroll = page.findChild(QScrollArea)
+        for w in (1512, 1280, 1024, 900, 800, 700, 640):
+            for h in (950, 600):
+                page.resize(w, h)
+                for _ in range(8):
+                    qapp.processEvents()
+                assert scroll.horizontalScrollBar().maximum() == 0, \
+                    f"{w}x{h} 에서 가로 스크롤"
+        # 되돌릴 때도(좁게 → 넓게) 마찬가지.
+        for w in (640, 1024, 1512):
+            page.resize(w, 950)
+            for _ in range(8):
+                qapp.processEvents()
+            assert scroll.horizontalScrollBar().maximum() == 0, f"{w} 복귀 시 가로 스크롤"
+    finally:
+        page.deleteLater()
+
+
+def test_legacy_toggle_does_not_move_at_any_width(qapp):
+    """구형 토글의 y 는 **어느 폭에서도** 켜고 끌 때 그대로다(위 테스트의 폭 일반화).
+
+    ★ 두 번째 회귀: 800px 창에서 구형을 켜면 내용이 길어져 **세로 스크롤바**가 나타나고,
+    가용 폭이 14px 줄면서 보조 레일이 본론 아래로 내려앉아 토글이 587 → 846px 로 튀었다.
+    폭 예산에서 스크롤바를 항상 빼(`_content_width`) 가로 배치를 세로 길이와 떼어 놨다."""
+    from PyQt6.QtWidgets import QScrollArea
+    page = sp.SetupPage()
+    try:
+        page.show()
+        scroll = page.findChild(QScrollArea)
+        for w in (1512, 1280, 1024, 900, 800, 700):
+            page.resize(w, 950)
+            for _ in range(8):
+                qapp.processEvents()
+
+            def _y() -> int:
+                return page.legacy_switch.mapTo(page, QPoint(0, 0)).y()
+
+            before = _y()
+            page.legacy_switch.set_on(True, emit=True)
+            for _ in range(8):
+                qapp.processEvents()
+            assert _y() == before, f"폭 {w}: 켤 때 {before} → {_y()}"
+            assert scroll.horizontalScrollBar().maximum() == 0, f"폭 {w}: 구형 ON 가로 스크롤"
+            page.legacy_switch.set_on(False, emit=True)
+            for _ in range(8):
+                qapp.processEvents()
+            assert _y() == before, f"폭 {w}: 끌 때 {before} → {_y()}"
+    finally:
+        page.deleteLater()
+
