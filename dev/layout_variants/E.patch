+    def _dock_aside(self, docked: bool, aside_w: int) -> None:
+        """레일을 본론 **옆**(docked)에 둘지 **아래**에 둘지."""
+        grid = getattr(self, "_split_grid", None)
+        if grid is None:
+            return
+        if grid.count() == 0 or getattr(self, "_aside_docked", None) is not docked:
+            while grid.count():
+                grid.takeAt(0)               # 위젯은 지우지 않는다(상태·연결 보존)
+            grid.addWidget(self._split_main, 0, 0)
+            if docked:
+                grid.addWidget(self._split_aside, 0, 1)
+            else:
+                grid.addWidget(self._split_aside, 1, 0)
+            grid.setColumnStretch(0, 1)      # 남는 폭은 전부 본론이 가져간다
+            grid.setColumnStretch(1, 0)
+            self._aside_docked = docked
+        if docked:
+            self._split_aside.setFixedWidth(aside_w)
+        else:
+            self._split_aside.setMinimumWidth(0)
+            self._split_aside.setMaximumWidth(QWIDGETSIZE_MAX)
