/* AOI 검증 — 절제된 다크 계측기 테마.
   이 파일은 템플릿: 달러 토큰을 theme.render_qss 가 theme.TOKENS 값으로 치환한다.
   원칙: 앰버(accent)는 주요 액션·선택 전용, 상태는 pass/danger/warn,
   키보드 포커스는 focus 링. 글로우 없음(NeonButton primary 만 예외). */

QWidget {
    background-color: $bg;
    color: $ink;
    font-family: $font_body;
    font-size: $font_base_sz;
}

QMainWindow, QDialog {
    background-color: $bg;
}

QLabel {
    color: $ink;
    background: transparent;
}

QLabel[role="title"] {
    font-family: $font_title;
    font-size: $font_title_sz;
    font-weight: $title_weight;
    color: $ink;
    letter-spacing: $title_tracking;
}

QLabel[role="subtitle"] {
    font-size: $font_sub_sz;
    color: $ink2;
}

QLabel[role="muted"] {
    color: $mute;
}

QLabel[role="mono"] {
    font-family: $font_mono;
}

/* ── 판정 칩 (매치 검토 A2) ──────────────────────────────────────────── */
QLabel[chip="ok"] {
    color: $pass;
    background-color: $chip_bg_ok;
    border: 1px solid transparent;
    border-radius: $chip_radius;
    padding: $chip_pad;
    letter-spacing: $chip_ls;
    font-family: $font_mono;
    font-size: $font_caption_sz;
    font-weight: 700;
}

QLabel[chip="over"] {
    color: $danger;
    background-color: $chip_bg_over;
    border: 1px solid transparent;
    border-radius: $chip_radius;
    padding: $chip_pad;
    letter-spacing: $chip_ls;
    font-family: $font_mono;
    font-size: $font_caption_sz;
    font-weight: 700;
}

QLabel[chip="none"] {
    color: $mute;
    background-color: transparent;
    border: 1px solid $chip_border_none;
    border-radius: $chip_radius;
    padding: $chip_pad;
    letter-spacing: $chip_ls;
    font-family: $font_mono;
    font-size: $font_caption_sz;
    font-weight: 700;
}

/* ── 카드 ───────────────────────────────────────────────────────────── */
QFrame[role="card"] {
    background-color: $panel;
    border: 1px solid $line2;
    border-radius: $radius;
}

QFrame[role="card-soft"] {
    background-color: $panel;
    border: 1px solid $line;
    border-radius: $radius;
}

QFrame[role="section"] {
    background-color: $panel;
    border: 1px solid $line;
    border-radius: 8px;
}

/* 매치 검토 행 — 변형별 card / hairline 지원. */
QFrame[role="row"] {
    background-color: $row_bg;
    border: 1px solid $row_border;
    border-bottom: 1px solid $row_divider;
    border-radius: $row_radius;
}

/* 점수 컬럼 눈금 — 이미지 영역과 우측 점수를 가르는 1px 눈금(C7).
   score_rule = ink 반투명이라 어두운 패널에서도 또렷(자기적응). */
QFrame[role="vrule"] {
    background: $score_rule;
    border: none;
    min-width: 1px;
    max-width: 1px;
}

/* 지브라 행(계측 벤치 성격) — cleanroom 전용. 홀수 행에 아주 옅은 띠. */
QFrame[role="row"][zebra="on"] {
    background-color: $zebra_bg;
}

/* 검토 리스트 컬럼 헤더 — 표/제도 시트 성격 변형에서만. 하단 눈금으로 표 헤더처럼. */
QFrame[role="listHeader"] {
    background: transparent;
    border: none;
    border-bottom: 1px solid $row_divider;
}
QLabel[role="colHead"] {
    color: $mute;
    font-size: $font_caption_sz;
    font-weight: 700;
    letter-spacing: 1px;
}

/* 매치 검토 행 상태 — 인라인 스타일 대신 동적 프로퍼티로 칠한다. */
QFrame[rowState="over"] {
    background-color: $danger_tint_soft;
    border: 1px solid $danger;
    border-radius: $row_radius;
}

QFrame[rowState="unmatched"] {
    background-color: $panel;
    border: 2px solid $danger;
    border-radius: $row_radius;
}

QFrame[current="true"] {
    border: $focus_w solid $accent;
}

/* ── 버튼 ───────────────────────────────────────────────────────────── */
QPushButton {
    background-color: transparent;
    color: $ink2;
    border: 1px solid $line2;
    border-radius: $radius_sm;
    padding: $pad_control;
    font-size: $font_base_sz;
    font-weight: 600;
    letter-spacing: 0px;
}

QPushButton:hover {
    background-color: $elev;
    color: $ink;
    border-color: $mute;
}

QPushButton:pressed {
    background-color: $line;
}

QPushButton:focus {
    border: $focus_w solid $focus;
    padding: $pad_control_focus;
}

QPushButton:disabled {
    color: $mute;
    border-color: $line;
    background-color: transparent;
}

QPushButton[role="primary"] {
    background-color: $accent;
    color: $on_accent;
    border: 1px solid $accent;
    font-weight: 700;
}
QPushButton[role="primary"]:hover {
    background-color: $accent_hover;
    border-color: $accent_hover;
    color: $on_accent;
}
QPushButton[role="primary"]:pressed {
    background-color: $accent_pressed;
}
QPushButton[role="primary"]:focus {
    border: $focus_w solid $focus;
    padding: $pad_control_focus;
}

QPushButton[role="danger"] {
    color: $danger;
    border-color: $danger;
}
QPushButton[role="danger"]:hover {
    background-color: $danger_tint;
    color: $danger;
}

QPushButton[role="warn"] {
    color: $warn;
    border-color: $warn;
}
QPushButton[role="warn"]:hover {
    background-color: $warn_tint;
}

QPushButton[role="ghost"] {
    color: $mute;
    border-color: $line;
}
QPushButton[role="ghost"]:hover {
    color: $ink;
    border-color: $line2;
    background-color: $elev;
}

QPushButton:checked {
    background-color: $accent_tint;
    color: $accent;
    border-color: $accent;
}

/* 컴팩트 아이콘 토글 (A2 행 ×/↩) — 평소엔 중립(mute), 상호작용 시에만 의미색.
   비활성 상태에 풀채도 강조를 두지 않는다(리스트에 빨간 박스 8개 방지). */
QPushButton[compact="true"] {
    padding: 4px 6px;
    font-size: 17px;
    font-weight: 700;
    color: $mute;
    border: 1px solid $line2;
    background: transparent;
}
QPushButton[compact="true"]:hover {
    color: $ink;
    border-color: $mute;
    background: $elev;
}
/* '매치 없음(reject)' 의도일 때만 hover 에서 위험색을 드러낸다. */
QPushButton[compact="true"][intent="reject"]:hover {
    color: $danger;
    border-color: $danger;
    background: $danger_tint;
}
QPushButton[compact="true"]:focus {
    border: $focus_w solid $focus;
    padding: 3px 5px;
}

/* 화면 스타일 스위처 칩 — 편안한 타깃, 선택 시 '채운' 강조로 현재 스타일이 한눈에(C24).
   ★ 완전한 박스 모델(배경·보더)을 base 에 둬야 :checked 배경이 확실히 칠해진다
   (부분 QSS 만 주면 Qt 가 배경을 네이티브로 폴백 → 채움이 안 보이는 버그). */
QPushButton[variantChip="true"] {
    padding: 7px 14px;
    font-size: $font_caption_sz;
    border: 1px solid $line;
    border-radius: $chip_radius;
    background: transparent;
    color: $mute;
    font-weight: 600;
}
QPushButton[variantChip="true"]:hover {
    color: $ink;
    border-color: $line2;
    background: $elev;
}
QPushButton[variantChip="true"]:checked {
    background: $accent;
    color: $on_accent;
    border-color: $accent;
    font-weight: 700;
}

/* 키캡(kbd) 칩 — 단축키를 본문 텍스트가 아니라 '키'로 읽히게. */
QLabel[role="kbd"] {
    background: $elev;
    border: 1px solid $line2;
    border-radius: 4px;
    color: $ink2;
    font-family: $font_mono;
    font-size: 11px;
    padding: 1px 7px;
}

/* 링크형 버튼 — 반복되는 2차 액션(크게 보기·더 보기·접기)용. 테두리 없이 조용히. */
QPushButton[role="link"] {
    background: transparent;
    border: 1px solid transparent;
    color: $mute;
    padding: 3px 4px;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
}
QPushButton[role="link"]:hover {
    color: $ink;
    background: $elev;
}
QPushButton[role="link"]:focus {
    border: 1px solid $focus;
    padding: 2px 3px;
}

/* ── 입력 위젯 ──────────────────────────────────────────────────────── */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: $elev;
    border: 1px solid $line2;
    border-radius: $radius_sm;
    padding: $pad_input;
    color: $ink;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: $focus_w solid $focus;
    padding: $pad_input_focus;
}

QSlider::groove:horizontal {
    height: 6px;
    background: $line;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: $ink2;
    width: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: $ink;
}
QSlider::sub-page:horizontal {
    background: $accent;
    border-radius: 3px;
}

QCheckBox {
    color: $ink;
    spacing: 8px;
}
QCheckBox::indicator {
    width: $check_sz;
    height: $check_sz;
    border: 2px solid $line2;
    border-radius: 4px;
    background: transparent;
}
QCheckBox::indicator:hover {
    border-color: $mute;
}
QCheckBox::indicator:checked {
    background: $accent;
    border-color: $accent;
}
QCheckBox:focus {
    color: $focus;
}

QRadioButton {
    color: $ink;
    spacing: 8px;
}
QRadioButton::indicator {
    width: $radio_sz;
    height: $radio_sz;
    border: 2px solid $line2;
    border-radius: 8px;
    background: transparent;
}
QRadioButton::indicator:hover {
    border-color: $mute;
}
QRadioButton::indicator:checked {
    background: $accent;
    border-color: $accent;
}
QRadioButton:focus {
    color: $focus;
}

/* ── 스크롤 ────────────────────────────────────────────────────────── */
QScrollBar:vertical, QScrollBar:horizontal {
    background: $bg;
    border: none;
    width: 10px;
    height: 10px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: $line2;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: $mute;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0; height: 0; background: transparent;
}

/* ── 진행 바 ────────────────────────────────────────────────────────── */
QProgressBar {
    background: $panel;
    border: 1px solid $line;
    border-radius: 6px;
    text-align: center;
    color: $ink;
    font-family: $font_mono;
}
QProgressBar::chunk {
    background: $accent;
    border-radius: 5px;
}

/* ── 그룹박스 ───────────────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid $line;
    border-radius: 8px;
    margin-top: 14px;
    padding: 10px 8px 8px 8px;
    color: $ink2;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: $ink;
    font-weight: 700;
    letter-spacing: 0px;
}

/* ── 툴팁/메시지 ─────────────────────────────────────────────────────── */
QToolTip {
    background-color: $elev;
    color: $ink;
    border: 1px solid $line2;
    padding: 8px;
    border-radius: 4px;
}

/* ── 도움말 토글 버튼 (? 버튼) ───────────────────────────────────────────── */
QToolButton[objectName="helpToggle"] {
    color: $mute;
    border: 1px solid $line2;
    border-radius: 11px;
    min-width: 22px;
    min-height: 22px;
    max-width: 22px;
    max-height: 22px;
    font-weight: 700;
    font-size: 13px;
    background: transparent;
    padding: 0;
}
QToolButton[objectName="helpToggle"]:hover {
    background: $elev;
    color: $ink;
}
QToolButton[objectName="helpToggle"]:checked {
    background: $accent_tint;
    color: $accent;
    border-color: $accent;
}
QToolButton[objectName="helpToggle"]:focus {
    border: 2px solid $focus;
}
