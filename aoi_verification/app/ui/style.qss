/* AOI 검증 — 절제된 다크 계측기 테마.
   이 파일은 템플릿: 달러 토큰을 theme.render_qss 가 theme.TOKENS 값으로 치환한다.
   원칙: 앰버(accent)는 주요 액션·선택 전용, 상태는 pass/danger/warn,
   키보드 포커스는 focus 링. 글로우 없음(NeonButton primary 만 예외). */

QWidget {
    background-color: $bg;
    color: $ink;
    font-family: $font_body;
    font-size: $font_base_sz;
}

QMainWindow, QDialog {
    background-color: $bg;
}

QLabel {
    color: $ink;
    background: transparent;
}

QLabel[role="title"] {
    font-family: $font_title;
    font-size: $font_title_sz;
    font-weight: $title_weight;
    color: $ink;
    letter-spacing: $title_tracking;
}

QLabel[role="subtitle"] {
    font-size: $font_sub_sz;
    color: $ink2;
}

QLabel[role="muted"] {
    color: $mute;
}

QLabel[role="mono"] {
    font-family: $font_mono;
}

/* ── 판정 칩 (매치 검토 A2) ──────────────────────────────────────────── */
QLabel[chip="ok"] {
    color: $pass;
    background-color: $chip_bg_ok;
    border: 1px solid transparent;
    border-radius: $chip_radius;
    padding: $chip_pad;
    letter-spacing: $chip_ls;
    font-family: $font_mono;
    font-size: $font_caption_sz;
    font-weight: 700;
}

QLabel[chip="over"] {
    color: $danger;
    background-color: $chip_bg_over;
    border: 1px solid transparent;
    border-radius: $chip_radius;
    padding: $chip_pad;
    letter-spacing: $chip_ls;
    font-family: $font_mono;
    font-size: $font_caption_sz;
    font-weight: 700;
}

QLabel[chip="none"] {
    color: $mute;
    background-color: transparent;
    border: 1px solid $chip_border_none;
    border-radius: $chip_radius;
    padding: $chip_pad;
    letter-spacing: $chip_ls;
    font-family: $font_mono;
    font-size: $font_caption_sz;
    font-weight: 700;
}

/* ── 카드 ───────────────────────────────────────────────────────────── */
/* 카드 외곽 — 면 구분(구조)을 담당하므로 눈금 등급($line)을 쓴다. */
QFrame[role="card"] {
    background-color: $panel;
    border: 1px solid $line;
    border-radius: $radius;
}

QFrame[role="card-soft"] {
    background-color: $panel;
    border: 1px solid $line;
    border-radius: $radius;
}

QFrame[role="section"] {
    background-color: $panel;
    border: 1px solid $line;
    border-radius: 8px;
}

/* 매치 검토 행 — 변형별 card / hairline 지원. */
QFrame[role="row"] {
    background-color: $row_bg;
    border: 1px solid $row_border;
    border-bottom: 1px solid $row_divider;
    border-radius: $row_radius;
}

/* 점수 컬럼 눈금 — 이미지 영역과 우측 거리 컬럼을 가르는 1px 눈금.
   score_rule = ink 반투명이라 시트 위에서 또렷. */
QFrame[role="vrule"] {
    background: $score_rule;
    border: none;
    min-width: 1px;
    max-width: 1px;
}

/* 검토 리스트 컬럼 헤더(타이틀블록) — 하단 눈금으로 제도 시트의 표 헤더처럼. */
QFrame[role="listHeader"] {
    background: transparent;
    border: none;
    border-bottom: 1px solid $row_divider;
}
QLabel[role="colHead"] {
    color: $mute;
    font-size: $font_caption_sz;
    font-weight: 700;
    letter-spacing: 1px;
}

/* 매치 검토 행 상태 — 인라인 스타일 대신 동적 프로퍼티로 칠한다. */
QFrame[rowState="over"] {
    background-color: $danger_tint_soft;
    border: 1px solid $danger;
    border-radius: $row_radius;
}

QFrame[rowState="unmatched"] {
    background-color: $panel;
    border: 2px solid $danger;
    border-radius: $row_radius;
}

QFrame[current="true"] {
    border: $focus_w solid $accent;
}

/* ── 버튼 ───────────────────────────────────────────────────────────── */
/* ★ 상호작용 컨트롤의 평상시 경계는 $line_strong 을 쓴다 — WCAG 1.4.11(비-텍스트
   3:1).  $line2 는 어떤 면에서도 2.0 을 못 넘겨 '보이지 않는 버튼'이 됐다(실측).
   $line2 는 이제 장식용(카드 외곽·칩 없음 보더)에만 남긴다. */
QPushButton {
    background-color: transparent;
    color: $ink2;
    border: 1px solid $line_strong;
    border-radius: $radius_sm;
    padding: $pad_control;
    font-size: $font_base_sz;
    font-weight: 600;
    letter-spacing: 0px;
    min-height: $target_min;
}

QPushButton:hover {
    background-color: $elev;
    color: $ink;
    border-color: $mute;
}

QPushButton:pressed {
    background-color: $line;
}

QPushButton:focus {
    border: $focus_w solid $focus;
    padding: $pad_control_focus;
}

QPushButton:disabled {
    color: $mute;
    border: 1px dashed $line;
    background-color: transparent;
}

QPushButton[role="primary"] {
    background-color: $accent;
    color: $on_accent;
    border: 1px solid $accent;
    font-weight: 700;
}
QPushButton[role="primary"]:hover {
    background-color: $accent_hover;
    border-color: $accent_hover;
    color: $on_accent;
}
QPushButton[role="primary"]:pressed {
    background-color: $accent_pressed;
}
/* ★ 속성 선택자가 일반 QPushButton:disabled 보다 특이도가 높아, 이 규칙이 없으면
   primary 는 비활성이어도 꽉 찬 채로 남아 '누를 수 있어 보이는 못 누르는 버튼'이 된다.
   ★ 면을 $line2 로 채우면 라벨($mute)이 그 위에서 3.42:1 로 떨어진다(실측) — 비워
   두면 라벨이 시트 면 위에 앉아 6.5:1 을 유지하면서도 '비어 있다 = 못 누른다'로 읽힌다. */
QPushButton[role="primary"]:disabled {
    background-color: transparent;
    color: $mute;
    border: 1px dashed $line;
    font-weight: 600;
}
/* ★ 채운 버튼의 포커스 링은 페이지 배경이 아니라 **버튼 자기 면**과 대비해야 한다.
   `$focus` 는 `$accent` 와 1.23:1(라이트)/1.30:1(다크) — 링을 그려도 자기 채움에
   묻혀 보이지 않았다(캡처 실측).  `$on_accent`(라벨 색)는 정의상 채움과 대비하므로
   6.5:1/8.57:1 을 보장한다. 링이 라벨과 붙지 않게 안쪽 눈금을 한 겹 둔다. */
QPushButton[role="primary"]:focus {
    border: $focus_w solid $on_accent;
    padding: $pad_control_focus;
}

QPushButton[role="danger"] {
    color: $danger;
    border-color: $danger;
}
QPushButton[role="danger"]:hover {
    background-color: $danger_tint;
    color: $danger;
}

QPushButton[role="warn"] {
    color: $warn;
    border-color: $warn;
}
QPushButton[role="warn"]:hover {
    background-color: $warn_tint;
}

QPushButton[role="ghost"] {
    color: $ink2;
    border-color: $line_strong;
}
QPushButton[role="ghost"]:hover {
    color: $ink;
    border-color: $accent;
    background-color: $elev;
}

/* ★ 역할별 :focus 를 반드시 따로 선언한다.  `QPushButton[role="ghost"]` 의
   border-color 는 위의 일반 `QPushButton:focus` 와 특이도가 같고 **뒤에** 선언돼 있어,
   전용 규칙이 없으면 포커스 링 색을 그대로 덮어쓴다 — 실제로 ghost/danger/warn 버튼은
   탭으로 이동해도 링이 전혀 그려지지 않았다(픽셀 실측으로 확인).
   `role="primary"` 는 이미 전용 규칙이 있어 살아 있었다. */
QPushButton[role="ghost"]:focus,
QPushButton[role="danger"]:focus,
QPushButton[role="warn"]:focus {
    border: $focus_w solid $focus;
    padding: $pad_control_focus;
}

QPushButton:checked {
    background-color: $accent_tint;
    color: $accent;
    border-color: $accent;
}

/* 옵션 타일 (OptionGroup) — 작은 라디오 대신 '타일 전체가 클릭영역'인 배타 선택.
   ★ 선택 상태를 여기서만 칠한다 — 위젯 쪽 인라인 스타일시트 금지(죽은 팔레트 하드코딩
   재발 방지 + 라이트/다크 자동 대응).  아래 :checked 는 위의 일반 QPushButton:checked 보다
   특이도가 높고 뒤에 선언돼 있어 특이도·순서가 모두 일치한다 — 재정렬 주의. */
QPushButton[role="option"] {
    background: transparent;
    color: $ink2;
    border: 1px solid $line_strong;
    border-radius: $radius_sm;
    padding: $pad_control;
    font-weight: 600;
    text-align: left;
    min-height: $control_h_lg;
}
QPushButton[role="option"]:hover {
    background-color: $elev;
    color: $ink;
    border-color: $mute;
}
QPushButton[role="option"]:checked {
    background-color: $accent_tint;
    color: $accent;
    border: 1px solid $accent;
    font-weight: 700;
}
QPushButton[role="option"]:focus {
    border: $focus_w solid $focus;
    padding: $pad_control_focus;
}
QPushButton[role="option"]:disabled {
    background: transparent;
    color: $mute;
    border: 1px dashed $line;
}
QPushButton[role="option"]:checked:disabled {
    background-color: $accent_tint_soft;
    color: $mute;
    border: 1px dashed $line;
}

/* 입력 오류 — 왜 [검증 시작] 을 누를 수 없는지 툴팁이 아니라 눈에 보이게. */
QLineEdit[state="invalid"] {
    border: 1px solid $danger;
    background-color: $danger_tint_soft;
}
QLineEdit[state="invalid"]:focus {
    border: $focus_w solid $danger;
    padding: $pad_input_focus;
}
QLabel[role="error"] {
    color: $danger;
    font-size: $font_caption_sz;
}

/* 로딩 패널 — 스크림을 옅게 해도 내용이 읽히도록 불투명 면 + 보더.
   "화면이 전부 가려진다"는 느낌 대신 초점만 남는다. */
QWidget[role="loadingPanel"] {
    background-color: $panel;
    border: 1px solid $line;
    border-radius: $radius;
}
/* 패널 안 컨테이너 — 맨 QWidget 은 전역 규칙의 $bg 를 물려받아 패널 면 위에 색이 다른
   띠로 보인다.  투명으로 못 박는다. */
QWidget[role="loadingBarHost"] {
    background: transparent;
}

/* C안 요약 값 — 상세를 접어 둔 채 시작하는 배치의 **안전 장치**.  가장 중요한 정보가
   가장 작고 옅은 글자였던 문제를 고친다(부제 등급 + 굵기 + 본문색). */
QLabel[role="summaryValue"] {
    font-size: $font_sub_sz;
    font-weight: 600;
    color: $ink;
}

/* 카드 제목 — 인라인 f-string 스타일 3중복을 대체. */
QLabel[role="cardTitle"] {
    color: $ink;
    font-weight: 700;
    letter-spacing: 1px;
}

/* 컴팩트 아이콘 토글 (A2 행 ×/↩) — 평소엔 중립(mute), 상호작용 시에만 의미색.
   비활성 상태에 풀채도 강조를 두지 않는다(리스트에 빨간 박스 8개 방지). */
QPushButton[compact="true"] {
    padding: 4px 6px;
    font-size: 17px;
    font-weight: 700;
    color: $ink2;
    border: 1px solid $line_strong;
    background: transparent;
}
QPushButton[compact="true"]:hover {
    color: $ink;
    border-color: $mute;
    background: $elev;
}
/* '매치 없음(reject)' 의도일 때만 hover 에서 위험색을 드러낸다. */
QPushButton[compact="true"][intent="reject"]:hover {
    color: $danger;
    border-color: $danger;
    background: $danger_tint;
}
QPushButton[compact="true"]:focus {
    border: $focus_w solid $focus;
    padding: 3px 5px;
}

/* 키캡(kbd) 칩 — 단축키를 본문 텍스트가 아니라 '키'로 읽히게. */
QLabel[role="kbd"] {
    background: $elev;
    border: 1px solid $line2;
    border-radius: 4px;
    color: $ink2;
    font-family: $font_mono;
    font-size: 11px;
    padding: 1px 7px;
}

/* 링크형 버튼 — 반복되는 2차 액션(크게 보기·더 보기·접기)용. 테두리 없이 조용히. */
QPushButton[role="link"] {
    background: transparent;
    border: 1px solid transparent;
    color: $mute;
    padding: 3px 4px;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
}
QPushButton[role="link"]:hover {
    color: $ink;
    background: $elev;
}
QPushButton[role="link"]:focus {
    border: 1px solid $focus;
    padding: 2px 3px;
}

/* ── 입력 위젯 ──────────────────────────────────────────────────────── */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: $elev;
    border: 1px solid $line_strong;
    border-radius: $radius_sm;
    padding: $pad_input;
    color: $ink;
    min-height: $input_h;
    /* 플레이스홀더는 Qt 기본(본문색 ~50% 알파)이면 3.31:1 로 떨어진다 — 본문과
       같은 등급의 보조색으로 고정한다. */
    placeholder-text-color: $mute;
}
/* 모드에 따라 무효해진 파라미터는 비활성으로 보여 준다(숨기지 않는다) — 그러니
   비활성 모습이 실제로 달라야 한다. */
QLineEdit:disabled, QComboBox:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: transparent;
    border: 1px dashed $line;
    color: $mute;
}
/* 스핀 버튼 — QSS 로는 삼각형 화살표를 그릴 수 없어(이미지 리소스 필요) 좁은 폭에서
   납작한 막대로 잘려 렌더된다.  사용자 화면(허용 오차)은 NoButtons + 진짜 ±  버튼으로
   대체했고(setup_page._stepper_button), 남은 스핀박스는 개발자 벤치마크 다이얼로그 전용
   이므로 Qt 네이티브 버튼을 **건드리지 않고** 폭만 넉넉히 준다. */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 18px;
}
QSlider:disabled::groove:horizontal {
    background: $line;
}
QSlider:disabled::sub-page:horizontal {
    background: $line2;
}
QSlider:disabled::handle:horizontal {
    background: $line2;
    border-color: $line;
}
QLabel:disabled {
    color: $mute;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: $focus_w solid $focus;
    padding: $pad_input_focus;
}

/* 슬라이더 — 트랙만으로는 핸들 클릭 타깃이 15px 밖에 안 됐다.  위젯 자체에 세로
   여유를 줘 WCAG 2.5.8(24px)을 넘기고, 핸들도 20px 로 키운다. */
QSlider:horizontal {
    min-height: $target_min;
}
QSlider::groove:horizontal {
    height: 8px;
    background: $line;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: $ink2;
    border: 1px solid $ink2;
    width: 20px;
    height: 20px;
    margin: -7px 0;
    border-radius: 10px;
}
QSlider::handle:horizontal:hover {
    background: $ink;
    border-color: $ink;
}
/* ★ 슬라이더 포커스 링은 QSS 로 만들 수 없다 — Qt 는 서브컨트롤에 :focus 를 지원하지
   않고, 위젯에 border 를 줘도 서브컨트롤이 스타일링된 슬라이더에선 렌더되지 않는다
   (실측).  `widgets/no_wheel_slider.py` 의 paintEvent 가 직접 그린다. */
QSlider::sub-page:horizontal {
    background: $accent;
    border-radius: 4px;
}

QCheckBox {
    color: $ink;
    spacing: 8px;
    min-height: $target_min;       /* 라벨까지가 클릭영역 — 행 높이로 타깃을 확보 */
}
QCheckBox::indicator {
    width: $check_sz;
    height: $check_sz;
    border: 2px solid $line_strong;
    border-radius: 4px;
    background: $elev;
}
QCheckBox::indicator:hover {
    border-color: $accent;
}
QCheckBox::indicator:checked {
    background: $accent;
    border-color: $accent;
}
/* 텍스트 색만 바꾸는 포커스 표시는 약하다 — 표시기에 링을 그린다. */
QCheckBox:focus::indicator {
    border: $focus_w solid $focus;
}
QCheckBox::indicator:disabled {
    border: 2px dashed $line;
    background: transparent;
}

QRadioButton {
    color: $ink;
    spacing: 8px;
    min-height: $target_min;
}
QRadioButton::indicator {
    width: $radio_sz;
    height: $radio_sz;
    border: 2px solid $line_strong;
    border-radius: 8px;
    background: $elev;
}
QRadioButton::indicator:hover {
    border-color: $accent;
}
QRadioButton::indicator:checked {
    background: $accent;
    border-color: $accent;
}
QRadioButton:focus::indicator {
    border: $focus_w solid $focus;
}

/* ── 스크롤 ────────────────────────────────────────────────────────── */
QScrollBar:vertical, QScrollBar:horizontal {
    background: $bg;
    border: none;
    width: 10px;
    height: 10px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: $line_strong;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: $mute;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0; height: 0; background: transparent;
}

/* ── 진행 바 ────────────────────────────────────────────────────────── */
/* ★ 바 안에 숫자를 넣지 않는다 — 채움이 글자 아래를 지나가는 순간 대비가 2.41(라이트)
   /1.85(다크) 로 붕괴한다(실측).  숫자는 바 **밖**의 모노 라벨이 담당한다
   (loading_overlay._count_label).  그래서 text-align/color 규칙도 없다. */
QProgressBar {
    background: $panel;
    border: 1px solid $line;
    border-radius: 6px;
}
QProgressBar::chunk {
    background: $accent;
    border-radius: 5px;
}
/* 진행 수치 — 바 밖에서 모노로. 시트 면 위라 대비가 흔들리지 않는다. */
QLabel[role="progressCount"] {
    font-family: $font_mono;
    font-size: $font_caption_sz;
    color: $ink2;
}

/* ── 그룹박스 ───────────────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid $line;
    border-radius: 8px;
    margin-top: 14px;
    padding: 10px 8px 8px 8px;
    color: $ink2;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: $ink;
    font-weight: 700;
    letter-spacing: 0px;
}

/* ── 툴팁/메시지 ─────────────────────────────────────────────────────── */
QToolTip {
    background-color: $elev;
    color: $ink;
    border: 1px solid $line2;
    padding: 8px;
    border-radius: 4px;
}

/* ── 도움말 토글 버튼 (? 버튼) ───────────────────────────────────────────── */
/* 26px — WCAG 2.5.8(AA) 24px 하한을 넘긴다(이전 22px 은 미달). */
QToolButton[objectName="helpToggle"] {
    color: $ink2;
    border: 1px solid $line_strong;
    border-radius: 13px;
    min-width: 26px;
    min-height: 26px;
    max-width: 26px;
    max-height: 26px;
    font-weight: 700;
    font-size: 14px;
    background: transparent;
    padding: 0;
}
QToolButton[objectName="helpToggle"]:hover {
    background: $elev;
    color: $ink;
}
QToolButton[objectName="helpToggle"]:checked {
    background: $accent_tint;
    color: $accent;
    border-color: $accent;
}
QToolButton[objectName="helpToggle"]:focus {
    border: 2px solid $focus;
}
